---
import { Github, Linkedin } from "lucide-preact";
import { LinesCanvas } from "~/components/composites/lines-canvas/LinesCanvas";
import { AnimatedButtonContainer } from "~/components/composites/animated-button-container/AnimatedButtonContainer";
import { AnimatedBoxLink, PulsatingDot, Text } from "~/components/primitives";
import { GITHUB, LINKEDIN } from "~/data/socialsLinks";
---

<section
  id="hero"
  class="relative mt-[4.125rem] flex h-[calc(100vh-4.125rem)] w-full flex-col items-center justify-center border-b border-b-bline text-center"
>
  <LinesCanvas client:idle />
  <Text
    element="h1"
    variant="gradient"
    className="mb-5 text-5xl font-bold md:mb-1 md:text-6xl"
  >
    Vladimir Infante
  </Text>
  <Text
    element="h2"
    variant="base"
    className="mb-3 text-2xl font-semibold md:mb-2 md:text-3xl"
  >
    Fullstack Developer
  </Text>
  <Text
    element="p"
    variant="base"
    className="mb-5 text-base font-semibold text-gray-200 md:text-lg"
  >
    I build great digital experiences using modern technologies
  </Text>
  <AnimatedButtonContainer isLink href="/contact">
    <PulsatingDot />
    Let's Connect
  </AnimatedButtonContainer>
  <div class="flex gap-x-6">
    <AnimatedBoxLink
      title="Go to Github"
      label="Checkout the github page for more information"
      link={GITHUB}
    >
      <Github class="h-6 w-6" />
    </AnimatedBoxLink>
    <AnimatedBoxLink
      title="Go to Linkedin"
      label="Checkout the linkedin profile for more information"
      link={LINKEDIN}
    >
      <Linkedin class="h-5 w-5" />
    </AnimatedBoxLink>
  </div>
</section>;
